# 复制为 .env 并填写真实值（.env 已被 gitignore，不会入库）
# 本地开发（dotenv）与 docker compose（变量插值）均从本文件读取
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=myshop
JWT_SECRET=your_random_long_secret
SILICONFLOW_API_KEY=sk-your_key
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端 API 基址：留空=同源（Docker 走 nginx 反代 / 本地 dev 走 vite 代理）；直连后端填 http://127.0.0.1:8360
VITE_API_BASE=

# 以下为 docker compose 可选覆盖项（仅当宿主机端口冲突时才需设置）
# MYSQL_HOST_PORT=3307
# REDIS_HOST_PORT=6380
# BACKEND_HOST_PORT=18360
# RAG_HOST_PORT=18361
# WEB_HOST_PORT=18080
